<?xml version="1.0" ?>
<robot name="panda" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- World Frame -->
  <link name="world"/>
  
  <!-- Link 0 - Base -->
  <link name="panda_link0">
    <visual>
      <geometry>
        <mesh filename="package://panda_description/meshes/visual/link0.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://panda_description/meshes/collision/link0.obj"/>
      </geometry>
    </collision>
      <inertial>
          <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
          <mass value="0.1"/>
          <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
  </link>

  <!-- World-Base Joint -->
  <joint name="virtual_joint" type="fixed">
    <parent link="world"/>
    <child link="panda_link0"/>
    <origin xyz="0.6 0 0.35" rpy="0 0 1.57"/>
  </joint>

  <!-- Link 1 -->
  <link name="panda_link1">
    <visual>
      <geometry>
        <mesh filename="package://panda_description/meshes/visual/link1.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://panda_description/meshes/collision/link1.obj"/>
      </geometry>
    </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
            <mass value="0.1"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
  </link>

  <!-- Joint 1 -->
  <joint name="panda_joint1" type="revolute">
    <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
    <origin rpy="0 0 0" xyz="0 0 0.333"/>
    <parent link="panda_link0"/>
    <child link="panda_link1"/>
    <axis xyz="0 0 1"/>
    <limit effort="30.0" lower="-2.9671" upper="2.9671" velocity="10.0"/>
  </joint>

  <!-- Link 2 -->
  <link name="panda_link2">
    <visual>
      <geometry>
        <mesh filename="package://panda_description/meshes/visual/link2.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://panda_description/meshes/collision/link2.obj"/>
      </geometry>
    </collision>
        <inertial>
          <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
          <mass value="0.1"/>
          <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
  </link>

  <!-- Joint 2 -->
  <joint name="panda_joint2" type="revolute">
    <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-1.7628" soft_upper_limit="1.7628"/>
    <origin rpy="-1.57079632679 0 0" xyz="0 0 0"/>
    <parent link="panda_link1"/>
    <child link="panda_link2"/>
    <axis xyz="0 0 1"/>
    <limit effort="30.0" lower="-1.8326" upper="1.8326" velocity="10.0"/>
  </joint>

  <!-- Link 3 -->
  <link name="panda_link3">
    <visual>
      <geometry>
        <mesh filename="package://panda_description/meshes/visual/link3.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://panda_description/meshes/collision/link3.obj"/>
      </geometry>
    </collision>
      <inertial>
          <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
          <mass value="0.1"/>
          <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
  </link>

  <!-- Joint 3 -->
  <joint name="panda_joint3" type="revolute">
    <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
    <origin rpy="1.57079632679 0 0" xyz="0 -0.316 0"/>
    <parent link="panda_link2"/>
    <child link="panda_link3"/>
    <axis xyz="0 0 1"/>
    <limit effort="30.0" lower="-2.9671" upper="2.9671" velocity="10.0"/>
  </joint>

  <!-- Link 4 -->
  <link name="panda_link4">
    <visual>
      <geometry>
        <mesh filename="package://panda_description/meshes/visual/link4.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://panda_description/meshes/collision/link4.obj"/>
      </geometry>
    </collision>
      <inertial>
          <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
          <mass value="0.1"/>
          <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
  </link>

  <!-- Joint 4 -->
  <joint name="panda_joint4" type="revolute">
    <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-3.0718" soft_upper_limit="-0.0698"/>
    <origin rpy="1.57079632679 0 0" xyz="0.0825 0 0"/>
    <parent link="panda_link3"/>
    <child link="panda_link4"/>
    <axis xyz="0 0 1"/>
    <limit effort="30.0" lower="-3.1416" upper="0.0" velocity="10.0"/>
  </joint>

  <!-- Link 5 -->
  <link name="panda_link5">
    <visual>
      <geometry>
        <mesh filename="package://panda_description/meshes/visual/link5.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://panda_description/meshes/collision/link5.obj"/>
      </geometry>
    </collision>
      <inertial>
          <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
          <mass value="0.1"/>
          <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
  </link>

  <!-- Joint 5 -->
  <joint name="panda_joint5" type="revolute">
    <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
    <origin rpy="-1.57079632679 0 0" xyz="-0.0825 0.384 0"/>
    <parent link="panda_link4"/>
    <child link="panda_link5"/>
    <axis xyz="0 0 1"/>
    <limit effort="30.0" lower="-2.9671" upper="2.9671" velocity="10.0"/>
  </joint>

  <!-- Link 6 -->
  <link name="panda_link6">
    <visual>
      <geometry>
        <mesh filename="package://panda_description/meshes/visual/link6.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://panda_description/meshes/collision/link6.obj"/>
      </geometry>
    </collision>
      <inertial>
          <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
          <mass value="0.1"/>
          <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
  </link>

  <!-- Joint 6 -->
  <joint name="panda_joint6" type="revolute">
    <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-0.0175" soft_upper_limit="3.7525"/>
    <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
    <parent link="panda_link5"/>
    <child link="panda_link6"/>
    <axis xyz="0 0 1"/>
    <limit effort="30.0" lower="-0.0873" upper="3.8223" velocity="10.0"/>
  </joint>

  <!-- Link 7 -->
  <link name="panda_link7">
    <visual>
      <geometry>
        <mesh filename="package://panda_description/meshes/visual/link7.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://panda_description/meshes/collision/link7.obj"/>
      </geometry>
    </collision>
      <inertial>
          <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
          <mass value="0.1"/>
          <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
  </link>

  <!-- Joint 7 -->
  <joint name="panda_joint7" type="revolute">
    <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
    <origin rpy="1.57079632679 0 0" xyz="0.088 0 0"/>
    <parent link="panda_link6"/>
    <child link="panda_link7"/>
    <axis xyz="0 0 1"/>
    <limit effort="30.0" lower="-2.9671" upper="2.9671" velocity="10.0"/>
  </joint>

  <!-- ========== ALLEGRO HAND (replaces original Panda gripper) ========== -->
  <xacro:property name="deg_to_rad" value="${pi/180.0}"/>
  <xacro:property name="allegro_reflect" value="1"/>  <!-- 1=right -->
  <xacro:property name="allegro_links_x" value="0.0196"/>
  <xacro:property name="allegro_links_y" value="0.0275"/>
  <xacro:property name="allegro_link0_z" value="0.0164"/>
  <xacro:property name="allegro_link1_z" value="0.0540"/>
  <xacro:property name="allegro_link2_z" value="0.0384"/>
  <xacro:property name="allegro_link3_z" value="0.0387"/>
  <xacro:property name="allegro_fingerTip_r" value="0.0120"/>
  <xacro:property name="allegro_joint_safety" value="0.1"/>
  <xacro:property name="allegro_link1_t_z" value="0.0177"/>
  <xacro:property name="allegro_link2_t_z" value="0.0514"/>
  <xacro:property name="allegro_link3_t_z" value="0.0543"/>
  <xacro:property name="allegro_palm_z" value="0.095"/>

  <!-- Dynamics macro -->
  <xacro:macro name="allegro_dynamics">
    <dynamics damping="1" friction="10"/>
  </xacro:macro>

  <!-- ========== ADAPTER LINK (rotates Allegro from vertical to horizontal) ========== -->
  <!-- Pitch -90deg: makes palm face DOWN when arm uses vertical quat [0,1,0,0] -->
  <!-- In adapter frame: +X = link7 +Z (downward), +Z = link7 -X (toward objects) -->
  <link name="allegro_adapter_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.015" length="0.04"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="adapter_gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.015" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="allegro_adapter_joint" type="fixed">
    <parent link="panda_link7"/>
    <child link="allegro_adapter_link"/>
    <origin xyz="0 0 0.106" rpy="0 -1.5708 0"/>
  </joint>

  <!-- ===== Palm (attached to adapter with X/Z offset) ===== -->
  <!-- X offset (adapter +X = downward): pushes palm lower for table reach -->
  <!-- Z offset (adapter +Z = forward): pushes palm toward objects -->
  <link name="allegro_palm_link">
    <inertial>
      <mass value="0.4154"/>
      <origin xyz="-0.0093 0 -${allegro_palm_z/2}" rpy="0 0 0"/>
      <inertia ixx="7.54436e-4" ixy="0" ixz="0" iyy="3.7004e-4" iyz="0" izz="4.99645e-4"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://panda_description/meshes/allegro/base_link.STL"/></geometry>
      <origin rpy="${1*deg_to_rad} 0 0" xyz="0 0 0"/>
      <material name="allegro_black"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="-0.0093 0 -${allegro_palm_z/2}" rpy="0 0 0"/>
      <geometry><box size="0.0408 0.1130 ${allegro_palm_z}"/></geometry>
    </collision>
  </link>
  <joint name="allegro_palm_joint" type="fixed">
    <parent link="allegro_adapter_link"/>
    <child link="allegro_palm_link"/>
    <origin xyz="0.02 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- ===== FINGER MACRO ===== -->
  <xacro:macro name="allegro_finger" params="finger_num *origin">
    <link name="allegro_finger_${finger_num}_rotatory_link">
      <inertial><mass value="0.0119"/><origin xyz="0 0 ${allegro_link0_z/2}"/>
        <inertia ixx="1.017e-05" ixy="0" ixz="0" iyy="6.477e-06" iyz="0" izz="1.131e-05"/></inertial>
      <visual><geometry><mesh filename="package://panda_description/meshes/allegro/link_0.0.STL"/></geometry><material name="allegro_black"/></visual>
      <collision><origin xyz="0 0 ${allegro_link0_z/2}"/><geometry><box size="${allegro_links_x} ${allegro_links_y} ${allegro_link0_z}"/></geometry></collision>
    </link>
    <joint name="allegro_finger_${finger_num}_rotatory_joint" type="revolute">
      <parent link="allegro_palm_link"/><child link="allegro_finger_${finger_num}_rotatory_link"/>
      <xacro:insert_block name="origin"/><axis xyz="0 0 1"/>
      <limit effort="15" velocity="7" lower="${-0.57+allegro_joint_safety}" upper="${0.57-allegro_joint_safety}"/>
      <xacro:allegro_dynamics/>
    </joint>

    <link name="allegro_finger_${finger_num}_flexor_1_link">
      <inertial><mass value="0.065"/><origin xyz="0 0 ${allegro_link1_z/2}"/>
        <inertia ixx="1.989e-05" ixy="0" ixz="0" iyy="1.788e-05" iyz="0" izz="6.177e-06"/></inertial>
      <visual><geometry><mesh filename="package://panda_description/meshes/allegro/link_1.0.STL"/></geometry><material name="allegro_black"/></visual>
      <collision><origin xyz="0 0 ${allegro_link1_z/2}"/><geometry><box size="${allegro_links_x} ${allegro_links_y} ${allegro_link1_z}"/></geometry></collision>
    </link>
    <joint name="allegro_finger_${finger_num}_flexor_1_joint" type="revolute">
      <parent link="allegro_finger_${finger_num}_rotatory_link"/><child link="allegro_finger_${finger_num}_flexor_1_link"/>
      <origin xyz="0 0 ${allegro_link0_z}"/><axis xyz="0 1 0"/>
      <limit effort="15" velocity="7" lower="${-0.296+allegro_joint_safety}" upper="${1.71-allegro_joint_safety}"/>
      <xacro:allegro_dynamics/>
    </joint>

    <link name="allegro_finger_${finger_num}_flexor_2_link">
      <inertial><mass value="0.0355"/><origin xyz="0 0 ${allegro_link2_z/2}"/>
        <inertia ixx="6.6e-06" ixy="0" ixz="0" iyy="5.5e-06" iyz="0" izz="3.37e-06"/></inertial>
      <visual><geometry><mesh filename="package://panda_description/meshes/allegro/link_2.0.STL"/></geometry><material name="allegro_black"/></visual>
      <collision><origin xyz="0 0 ${allegro_link2_z/2}"/><geometry><box size="${allegro_links_x} ${allegro_links_y} ${allegro_link2_z}"/></geometry></collision>
    </link>
    <joint name="allegro_finger_${finger_num}_flexor_2_joint" type="revolute">
      <parent link="allegro_finger_${finger_num}_flexor_1_link"/><child link="allegro_finger_${finger_num}_flexor_2_link"/>
      <origin xyz="0 0 ${allegro_link1_z}"/><axis xyz="0 1 0"/>
      <limit effort="15" velocity="7" lower="${-0.274+allegro_joint_safety}" upper="${1.809-allegro_joint_safety}"/>
      <xacro:allegro_dynamics/>
    </joint>

    <link name="allegro_finger_${finger_num}_flexor_3_link">
      <inertial><mass value="0.0096"/><origin xyz="0 0 ${(allegro_link3_z-allegro_fingerTip_r*2)/2}"/>
        <inertia ixx="1.18e-06" ixy="0" ixz="0" iyy="8.78e-07" iyz="0" izz="9.12e-07"/></inertial>
      <visual><geometry><mesh filename="package://panda_description/meshes/allegro/link_3.0.STL"/></geometry><material name="allegro_black"/></visual>
      <collision><origin xyz="0 0 ${(allegro_link3_z-allegro_fingerTip_r*2)/2}"/><geometry><box size="${allegro_links_x} ${allegro_links_y} ${allegro_link3_z-allegro_fingerTip_r*2}"/></geometry></collision>
    </link>
    <joint name="allegro_finger_${finger_num}_flexor_3_joint" type="revolute">
      <parent link="allegro_finger_${finger_num}_flexor_2_link"/><child link="allegro_finger_${finger_num}_flexor_3_link"/>
      <origin xyz="0 0 ${allegro_link2_z}"/><axis xyz="0 1 0"/>
      <limit effort="15" velocity="7" lower="${-0.327+allegro_joint_safety}" upper="${1.718-allegro_joint_safety}"/>
      <xacro:allegro_dynamics/>
    </joint>

    <link name="allegro_finger_${finger_num}_tip_link">
      <inertial><mass value="0.0168"/><inertia ixx="9.68e-07" ixy="0" ixz="0" iyy="9.68e-07" iyz="0" izz="9.68e-07"/></inertial>
      <visual><geometry><mesh filename="package://panda_description/meshes/allegro/link_3.0_tip.STL"/></geometry>
        <material name="allegro_white"><color rgba="0.9 0.9 0.9 1"/></material></visual>
      <collision><geometry><sphere radius="${allegro_fingerTip_r}"/></geometry></collision>
    </link>
    <joint name="allegro_finger_${finger_num}_tip_joint" type="fixed">
      <parent link="allegro_finger_${finger_num}_flexor_3_link"/><child link="allegro_finger_${finger_num}_tip_link"/>
      <origin xyz="0 0 ${allegro_link3_z-allegro_fingerTip_r}"/>
    </joint>
  </xacro:macro>

  <!-- ===== THUMB ===== -->
  <link name="allegro_thumb_rotatory_link">
    <inertial><mass value="0.0176"/><origin xyz="${-0.0358/2} ${allegro_reflect*.018/2} ${.029/2}"/>
      <inertia ixx="8.14e-06" ixy="-2.55e-06" ixz="3.9e-06" iyy="1.31e-05" iyz="1.46e-06" izz="1.0e-05"/></inertial>
    <visual><geometry><mesh filename="package://panda_description/meshes/allegro/link_12.0.STL" scale="1 1 1"/></geometry>
      <material name="allegro_black"/><origin rpy="${1*deg_to_rad} 0 0" xyz="0 0 0"/></visual>
    <collision><origin rpy="${1*deg_to_rad} 0 0"/><geometry><box size="0.0358 0.034 0.0455"/></geometry></collision>
  </link>
  <joint name="allegro_thumb_rotatory_joint" type="revolute">
    <parent link="allegro_palm_link"/><child link="allegro_thumb_rotatory_link"/>
    <origin xyz="-0.0182 ${allegro_reflect*0.019333} -0.045987" rpy="0 -${95*deg_to_rad} ${-allegro_reflect*90*deg_to_rad}"/>
    <axis xyz="${-allegro_reflect} 0 0"/>
    <limit effort="15" velocity="7" lower="${0.363+allegro_joint_safety}" upper="${1.496-allegro_joint_safety}"/>
    <dynamics damping="0.11" friction="0.1"/>
  </joint>

  <link name="allegro_thumb_flexor_1_link">
    <inertial><mass value="0.0119"/><origin xyz="0 0 ${allegro_link1_t_z/2}"/>
      <inertia ixx="1.93e-06" ixy="0" ixz="0" iyy="1.15e-06" iyz="0" izz="1.5e-06"/></inertial>
    <visual><geometry><mesh filename="package://panda_description/meshes/allegro/link_13.0.STL"/></geometry><material name="allegro_black"/></visual>
    <collision><origin xyz="0 0 ${allegro_link1_t_z/2}"/><geometry><box size="${allegro_links_x} ${allegro_links_y} ${allegro_link1_t_z}"/></geometry></collision>
  </link>
  <joint name="allegro_thumb_flexor_1_joint" type="revolute">
    <parent link="allegro_thumb_rotatory_link"/><child link="allegro_thumb_flexor_1_link"/>
    <origin xyz="-0.027 ${allegro_reflect*0.005} 0.0399"/><axis xyz="0 0 ${allegro_reflect}"/>
    <limit effort="15" velocity="7" lower="${-0.205+allegro_joint_safety}" upper="${1.263-allegro_joint_safety}"/>
    <xacro:allegro_dynamics/>
  </joint>

  <link name="allegro_thumb_flexor_2_link">
    <inertial><mass value="0.038"/><origin xyz="0 0 ${allegro_link2_t_z/2}"/>
      <inertia ixx="1.08e-05" ixy="0" ixz="0" iyy="9.58e-06" iyz="0" izz="3.61e-06"/></inertial>
    <visual><geometry><mesh filename="package://panda_description/meshes/allegro/link_14.0.STL"/></geometry><material name="allegro_black"/></visual>
    <collision><origin xyz="0 0 ${allegro_link2_t_z/2}"/><geometry><box size="${allegro_links_x} ${allegro_links_y} ${allegro_link2_t_z}"/></geometry></collision>
  </link>
  <joint name="allegro_thumb_flexor_2_joint" type="revolute">
    <parent link="allegro_thumb_flexor_1_link"/><child link="allegro_thumb_flexor_2_link"/>
    <origin xyz="0 0 ${allegro_link1_t_z}"/><axis xyz="0 1 0"/>
    <limit effort="15" velocity="7" lower="${-0.289+allegro_joint_safety}" upper="${1.744-allegro_joint_safety}"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <link name="allegro_thumb_flexor_3_link">
    <inertial><mass value="0.0388"/><origin xyz="0 0 ${(allegro_link3_t_z-allegro_fingerTip_r*2)/2}"/>
      <inertia ixx="8.06e-06" ixy="0" ixz="0" iyy="6.88e-06" iyz="0" izz="3.61e-06"/></inertial>
    <visual><geometry><mesh filename="package://panda_description/meshes/allegro/link_15.0.STL"/></geometry><material name="allegro_black"/></visual>
    <collision><origin xyz="0 0 ${(allegro_link3_t_z-allegro_fingerTip_r*2)/2}"/><geometry><box size="${allegro_links_x} ${allegro_links_y} ${allegro_link3_t_z-allegro_fingerTip_r}"/></geometry></collision>
  </link>
  <joint name="allegro_thumb_flexor_3_joint" type="revolute">
    <parent link="allegro_thumb_flexor_2_link"/><child link="allegro_thumb_flexor_3_link"/>
    <origin xyz="0 0 ${allegro_link2_t_z}"/><axis xyz="0 1 0"/>
    <limit effort="15" velocity="7" lower="${-0.262+allegro_joint_safety}" upper="${1.819-allegro_joint_safety}"/>
    <xacro:allegro_dynamics/>
  </joint>

  <link name="allegro_thumb_tip_link">
    <inertial><mass value="0.0168"/><inertia ixx="9.68e-07" ixy="0" ixz="0" iyy="9.68e-07" iyz="0" izz="9.68e-07"/></inertial>
    <visual><geometry><mesh filename="package://panda_description/meshes/allegro/link_15.0_tip.STL"/></geometry><material name="allegro_black"/></visual>
    <collision><geometry><sphere radius="${allegro_fingerTip_r}"/></geometry></collision>
  </link>
  <joint name="allegro_thumb_tip_joint" type="fixed">
    <parent link="allegro_thumb_flexor_3_link"/><child link="allegro_thumb_tip_link"/>
    <origin xyz="0 0 ${allegro_link3_t_z-allegro_fingerTip_r}"/>
  </joint>

  <!-- ===== Instantiate 3 fingers ===== -->
  <xacro:allegro_finger finger_num="1">
    <origin xyz="0 ${0.0435*allegro_reflect} -0.001542" rpy="${5.0*deg_to_rad*-allegro_reflect} 0 0"/>
  </xacro:allegro_finger>
  <xacro:allegro_finger finger_num="2">
    <origin xyz="0 0 0.0007" rpy="0 0 0"/>
  </xacro:allegro_finger>
  <xacro:allegro_finger finger_num="3">
    <origin xyz="0 ${0.0435*-allegro_reflect} -0.001542" rpy="${5.0*deg_to_rad*allegro_reflect} 0 0"/>
  </xacro:allegro_finger>

  <!-- ===== Disable self-collision for all Allegro links ===== -->
