        <joint name="allegro_finger_3_flexor_2_joint" value="0.0"/>
        <joint name="allegro_finger_3_flexor_3_joint" value="0.0"/>
    </group_state>
    <group_state name="close" group="gripper">
        <joint name="allegro_thumb_rotatory_joint" value="1.0"/>
        <joint name="allegro_thumb_flexor_1_joint" value="0.8"/>
        <joint name="allegro_thumb_flexor_2_joint" value="1.0"/>
        <joint name="allegro_thumb_flexor_3_joint" value="1.0"/>
        <joint name="allegro_finger_1_rotatory_joint" value="0.0"/>
        <joint name="allegro_finger_1_flexor_1_joint" value="1.0"/>
        <joint name="allegro_finger_1_flexor_2_joint" value="1.0"/>
        <joint name="allegro_finger_1_flexor_3_joint" value="1.0"/>
        <joint name="allegro_finger_2_rotatory_joint" value="0.0"/>
        <joint name="allegro_finger_2_flexor_1_joint" value="1.0"/>
