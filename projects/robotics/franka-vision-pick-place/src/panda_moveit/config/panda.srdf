        <joint name="allegro_finger_2_flexor_3_joint" value="1.0"/>
        <joint name="allegro_finger_3_rotatory_joint" value="0.0"/>
        <joint name="allegro_finger_3_flexor_1_joint" value="1.0"/>
        <joint name="allegro_finger_3_flexor_2_joint" value="1.0"/>
        <joint name="allegro_finger_3_flexor_3_joint" value="1.0"/>
    </group_state>
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="panda_link0"/>

    <!-- Panda arm self-collisions -->
    <disable_collisions link1="panda_link0" link2="panda_link1" reason="Adjacent"/>
