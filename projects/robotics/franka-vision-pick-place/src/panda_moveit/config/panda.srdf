        <joint name="allegro_finger_3_flexor_1_joint"/>
        <joint name="allegro_finger_3_flexor_2_joint"/>
        <joint name="allegro_finger_3_flexor_3_joint"/>
    </group>
    <group_state name="home" group="arm">
        <joint name="panda_joint1" value="0"/>
        <joint name="panda_joint2" value="0"/>
        <joint name="panda_joint3" value="0"/>
        <joint name="panda_joint4" value="-1.5708"/>
        <joint name="panda_joint5" value="0"/>
        <joint name="panda_joint6" value="1.6071"/>
        <joint name="panda_joint7" value="0.8804"/>
    </group_state>
    <group_state name="open" group="gripper">
        <joint name="allegro_thumb_rotatory_joint" value="0.463"/>
        <joint name="allegro_thumb_flexor_1_joint" value="0.0"/>
        <joint name="allegro_thumb_flexor_2_joint" value="0.0"/>
        <joint name="allegro_thumb_flexor_3_joint" value="0.0"/>
        <joint name="allegro_finger_1_rotatory_joint" value="0.0"/>
        <joint name="allegro_finger_1_flexor_1_joint" value="0.0"/>
        <joint name="allegro_finger_1_flexor_2_joint" value="0.0"/>
        <joint name="allegro_finger_1_flexor_3_joint" value="0.0"/>
        <joint name="allegro_finger_2_rotatory_joint" value="0.0"/>
        <joint name="allegro_finger_2_flexor_1_joint" value="0.0"/>
