<?xml version="1.0" encoding="UTF-8"?>
<robot name="panda">
    <group name="arm">
        <chain base_link="panda_link0" tip_link="panda_link7"/>
    </group>
    <group name="gripper">
        <link name="allegro_palm_link"/>
        <joint name="allegro_thumb_rotatory_joint"/>
        <joint name="allegro_thumb_flexor_1_joint"/>
        <joint name="allegro_thumb_flexor_2_joint"/>
        <joint name="allegro_thumb_flexor_3_joint"/>
        <joint name="allegro_finger_1_rotatory_joint"/>
        <joint name="allegro_finger_1_flexor_1_joint"/>
        <joint name="allegro_finger_1_flexor_2_joint"/>
        <joint name="allegro_finger_1_flexor_3_joint"/>
        <joint name="allegro_finger_2_rotatory_joint"/>
